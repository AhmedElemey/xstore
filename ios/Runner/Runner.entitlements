<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>development</string>
	<!-- Universal Links. `?mode=developer` is debug-build-only (Apple skips
	     the hosted apple-app-site-association check for a build run from
	     Xcode on a real device signed with this entitlement's Team ID) —
	     lets QA tap real https://xstore.com/... links in Notes/Messages
	     before the production AASA file exists. Do NOT copy this suffix
	     into RunnerRelease.entitlements — a release/TestFlight build must
	     go through real domain verification, and `mode=developer` there
	     would silently disable it. See
	     docs_business/launch_todos/07_deep_linking.md. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:xstore.com?mode=developer</string>
		<string>applinks:www.xstore.com?mode=developer</string>
	</array>
</dict>
</plist>
